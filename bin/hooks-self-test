#!/usr/bin/env bash
#
# hooks-self-test — smoke tests for .claude/hooks/*.sh, run against the
# scripts directly via stdin (no live Claude Code session needed). Must be
# green before every change to .claude/hooks/ or .claude/settings.json.

set -uo pipefail

HOOKS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.claude/hooks"

PASS=0
FAIL=0

# run_hook script command [cwd] — feeds a synthetic PreToolUse Bash payload
# to $script and prints the hook's stdout.
run_hook() {
  local script="$1" command="$2" cwd="${3:-$PWD}"
  jq -n --arg cmd "$command" --arg cwd "$cwd" \
    '{tool_name: "Bash", tool_input: {command: $cmd}, cwd: $cwd}' \
    | "$HOOKS_DIR/$script"
}

# assert_decision output expected_decision label
# expected_decision: "allow" (no output / no deny) or "deny"
assert_decision() {
  local output="$1" expected="$2" label="$3"
  local actual
  if [ -z "$output" ]; then
    actual="allow"
  else
    actual="$(echo "$output" | jq -r '.hookSpecificOutput.permissionDecision // "allow"' 2>/dev/null)"
  fi
  if [ "$actual" = "$expected" ]; then
    PASS=$((PASS + 1))
  else
    FAIL=$((FAIL + 1))
    printf 'FAIL %s\n  expected: %s\n  actual:   %s\n  output:   %s\n' "$label" "$expected" "$actual" "$output" >&2
  fi
}

# ── bash-guard.sh ──────────────────────────────────────────────────────────

FIXTURE="$(mktemp -d "${TMPDIR:-/tmp}/hooks-test-workspace.XXXXXX")"
trap 'rm -rf "$FIXTURE"' EXIT
git -C "$FIXTURE" init -q -b master
git -C "$FIXTURE" config user.email test@test
git -C "$FIXTURE" config user.name test
git -C "$FIXTURE" commit -q --allow-empty -m init

git -C "$FIXTURE" checkout -q -b feature

assert_decision "$(run_hook bash-guard.sh 'rm -rf /')" deny \
  'bash-guard: rm -rf /'
assert_decision "$(run_hook bash-guard.sh 'rm -rf ~')" deny \
  'bash-guard: rm -rf ~'
assert_decision "$(run_hook bash-guard.sh 'rm -rf $HOME')" deny \
  'bash-guard: rm -rf $HOME'
assert_decision "$(run_hook bash-guard.sh 'rm -rf ./build')" allow \
  'bash-guard: rm -rf ./build (scoped path allowed)'
assert_decision "$(run_hook bash-guard.sh 'rm -rf node_modules')" allow \
  'bash-guard: rm -rf node_modules (scoped path allowed)'

assert_decision "$(run_hook bash-guard.sh 'git push --force origin master' "$FIXTURE")" deny \
  'bash-guard: push --force origin master'
assert_decision "$(run_hook bash-guard.sh 'git push --force origin main' "$FIXTURE")" deny \
  'bash-guard: push --force origin main'
assert_decision "$(run_hook bash-guard.sh 'git push --force-with-lease origin main:main' "$FIXTURE")" deny \
  'bash-guard: push --force-with-lease refspec main:main'
assert_decision "$(run_hook bash-guard.sh 'git push --force origin feature-x' "$FIXTURE")" allow \
  'bash-guard: push --force to a named non-main/master branch is allowed'
assert_decision "$(run_hook bash-guard.sh 'git push origin master' "$FIXTURE")" allow \
  'bash-guard: push without --force is allowed'

git -C "$FIXTURE" checkout -q master
assert_decision "$(run_hook bash-guard.sh 'git push --force' "$FIXTURE")" deny \
  'bash-guard: push --force with no branch while on master falls back to current branch'
git -C "$FIXTURE" checkout -q feature
assert_decision "$(run_hook bash-guard.sh 'git push --force' "$FIXTURE")" allow \
  'bash-guard: push --force with no branch while on a feature branch is allowed'

assert_decision "$(run_hook bash-guard.sh 'git reset --hard HEAD~1')" deny \
  'bash-guard: reset --hard'
assert_decision "$(run_hook bash-guard.sh 'git reset --soft HEAD~1')" allow \
  'bash-guard: reset --soft is allowed'

assert_decision "$(run_hook bash-guard.sh 'git tag -d v1.0.0')" deny \
  'bash-guard: tag -d'
assert_decision "$(run_hook bash-guard.sh 'git tag --delete v1.0.0')" deny \
  'bash-guard: tag --delete'
assert_decision "$(run_hook bash-guard.sh 'git tag -a v1.0.0 -m 1.0.0')" allow \
  'bash-guard: tag -a (create) is allowed'
assert_decision "$(run_hook bash-guard.sh 'gh pr merge 6 --squash --delete-branch && git tag -a v1.0.0 -m 1.0.0')" allow \
  'bash-guard: --delete-branch in another segment does not trip tag -d'
assert_decision "$(run_hook bash-guard.sh 'git tag -a v1.0.0 -m 1.0.0; git tag -d v1.0.0')" deny \
  'bash-guard: tag -d in a later segment still denied'

assert_decision "$(run_hook bash-guard.sh 'git status')" allow \
  'bash-guard: harmless git status'
assert_decision "$(run_hook bash-guard.sh 'composer build')" allow \
  'bash-guard: unrelated command'

out="$(jq -n '{tool_name: "Edit", tool_input: {file_path: "/x"}}' | "$HOOKS_DIR/bash-guard.sh")"
assert_decision "$out" allow 'bash-guard: non-Bash tool_name is ignored'

heredoc_cmd=$(cat <<'OUTER'
git commit -m "$(cat <<'EOF'
Some commit message that mentions rm -rf / and git push --force in prose.
EOF
)"
OUTER
)
assert_decision "$(run_hook bash-guard.sh "$heredoc_cmd")" allow \
  'bash-guard: danger words inside a heredoc commit-message body are not code, not scanned'

heredoc_cmd_plus_danger=$(cat <<'OUTER'
git commit -m "$(cat <<'EOF'
An innocuous commit message.
EOF
)"
git reset --hard HEAD~1
OUTER
)
assert_decision "$(run_hook bash-guard.sh "$heredoc_cmd_plus_danger")" deny \
  'bash-guard: real danger command outside the heredoc body is still caught'

# ── pre-commit-audit.sh ────────────────────────────────────────────────────

REPO_ROOT="$(cd "$HOOKS_DIR/.." && pwd)"

BROKEN_PKG="$(mktemp -d "${TMPDIR:-/tmp}/hooks-test-broken-pkg.XXXXXX")/broken-pkg"
mkdir -p "$BROKEN_PKG/src"
printf '{"name": "rasuvaeff/broken-pkg"}\n' >"$BROKEN_PKG/composer.json"
git -C "$BROKEN_PKG" init -q -b master
git -C "$BROKEN_PKG" config user.email test@test
git -C "$BROKEN_PKG" config user.name test
git -C "$BROKEN_PKG" add -A
git -C "$BROKEN_PKG" commit -q -m 'Initial skeleton'

SKELETON_PKG="$(mktemp -d "${TMPDIR:-/tmp}/hooks-test-skeleton-pkg.XXXXXX")/skeleton-pkg"
mkdir -p "$SKELETON_PKG/src"
printf '{"name": "rasuvaeff/skeleton-pkg"}\n' >"$SKELETON_PKG/composer.json"

trap 'rm -rf "$FIXTURE" "$(dirname "$BROKEN_PKG")" "$(dirname "$SKELETON_PKG")"' EXIT

assert_decision "$(run_hook pre-commit-audit.sh 'git commit -m "msg"' "$REPO_ROOT/duration")" allow \
  'pre-commit-audit: clean published package (duration) passes structural audit'
assert_decision "$(run_hook pre-commit-audit.sh 'git commit -m "msg"' "$REPO_ROOT")" allow \
  'pre-commit-audit: commit at monorepo root (no composer.json) is skipped'
assert_decision "$(run_hook pre-commit-audit.sh 'git status' "$REPO_ROOT/duration")" allow \
  'pre-commit-audit: non-commit git command is ignored'
assert_decision "$(run_hook pre-commit-audit.sh "git -C duration commit -m \"msg\"" "$REPO_ROOT")" allow \
  'pre-commit-audit: -C <dir> form resolves target package'
assert_decision "$(run_hook pre-commit-audit.sh "cd duration && git commit -m \"msg\"" "$REPO_ROOT")" allow \
  'pre-commit-audit: cd <dir> && form resolves target package'
assert_decision "$(run_hook pre-commit-audit.sh 'git commit -m "msg"' "$BROKEN_PKG")" deny \
  'pre-commit-audit: package missing required files is denied'
assert_decision "$(run_hook pre-commit-audit.sh "cd duration
git status
git commit -m \"msg\"" "$REPO_ROOT")" allow \
  'pre-commit-audit: multi-line script with cd on its own line resolves target package'
assert_decision "$(run_hook pre-commit-audit.sh "cd \"$BROKEN_PKG\" && git init -q && git add -A && git commit -m \"msg\"" "$REPO_ROOT")" deny \
  'pre-commit-audit: multi-command chain ending in commit resolves via tracked cd'
assert_decision "$(run_hook pre-commit-audit.sh 'SCRATCH=/tmp/whatever
cd "$SCRATCH/pkg" && git init -q && git add -A && git commit -m "msg"' "$REPO_ROOT")" deny \
  'pre-commit-audit: cd target using an unexpanded shell variable is fail-closed denied'
assert_decision "$(run_hook pre-commit-audit.sh "cd \"$SKELETON_PKG\" && git init -q && git add -A && git commit -m \"Initial skeleton\"" "$REPO_ROOT")" allow \
  'pre-commit-audit: initial skeleton commit (no prior HEAD) is exempt from the audit, per create-php-package step 3'

out="$(jq -n '{tool_name: "Edit", tool_input: {file_path: "/x"}}' | "$HOOKS_DIR/pre-commit-audit.sh")"
assert_decision "$out" allow 'pre-commit-audit: non-Bash tool_name is ignored'

# ── summary ─────────────────────────────────────────────────────────────────
printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
